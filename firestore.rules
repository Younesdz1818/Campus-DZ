rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }

    match /studentNumbers/{studentNumber} {
      allow create: if signedIn()
        && studentNumber.matches('^[0-9]{16}$')
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid;
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/studentNumbers/$(studentNumber)) || resource.data.uid == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow update, delete: if false;
    }

    match /studentApplications/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.studentNumber is string
        && request.resource.data.studentNumber.matches('^[0-9]{16}$')
        && getAfter(/databases/$(database)/documents/studentNumbers/$(request.resource.data.studentNumber)).data.uid == uid
        && request.resource.data.keys().hasOnly(['uid','studentNumber','status','frontPath','backPath','createdAt']);
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow update, delete: if isAdmin();
    }
  }
}
